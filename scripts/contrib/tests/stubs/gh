#!/bin/bash
# 影子 stub：gh —— 记录调用；issue 列表由 STUB_GH_ISSUES_FILE 提供（默认空数组）
# 行为旋钮：
#   STUB_GH_FAIL=1          → exit 1
#   STUB_GH_ISSUES_FILE=<f> → stdout 输出该文件内容（issue JSON 数组，驱动 scan_gate）
#   STUB_GH_LATEST=<n>      → 对 `--jq '.[0].number'` 的 --init 调用输出该数字
# own-PR 盯梢新增旋钮（09-10；不设时既有行为 byte 级保留——pr list 落回 ISSUES_FILE/[] 通用尾）：
#   STUB_GH_PRS_FILE=<f>    → `pr list` 输出该文件内容（own PR JSON 数组；消费方 = unit/l2-ledger.sh 的台账存在性判定）
#   STUB_GH_VIEW_DIR=<dir>  → `pr view <N>` 输出 <dir>/pr-<N>.json；文件缺失 → exit 1
#                             （可模拟单 PR 终态核实失败）
#   STUB_GH_PR_CREATE_URL=<u> → `pr create` 输出该 URL（l2_ledger.sh publish 用）
#   STUB_GH_PR_CREATE_FAIL=1  → `pr create` exit 1
set -u
NAME="gh"
LOG_DIR="${STUB_LOG_DIR:-}"
if [[ -z "$LOG_DIR" ]]; then
  echo "stub $NAME: STUB_LOG_DIR 未设置（拒绝在沙箱外运行）" >&2
  exit 97
fi
mkdir -p "$LOG_DIR/bodies" 2>/dev/null || true

n=$(( $(cat "$LOG_DIR/.seq-$NAME" 2>/dev/null || echo 0) + 1 ))
printf '%s\n' "$n" >"$LOG_DIR/.seq-$NAME"

line="$NAME|$PWD|"
first=1
prev=""
for a in "$@"; do
  if [[ $first -eq 0 ]]; then line="$line "; fi
  line="$line$a"
  first=0
  if [[ "$prev" == "--jq" ]]; then
    printf '%s\n' "$a" >"$LOG_DIR/bodies/$NAME-$n.jq"
  fi
  prev="$a"
done
printf '%s\n' "$line" >>"$LOG_DIR/calls.log"

if [[ "${STUB_GH_FAIL:-}" == "1" ]]; then
  echo "gh stub: 模拟失败" >&2
  exit 1
fi

# pr 子命令分派（锚定首 token，非子串；[[ ]] 字面量匹配大小写敏感，避开 case 大小写不敏感坑）。
# 旋钮未设时**不拦截**——落回文件尾部既有通用行为（ISSUES_FILE/[]），既有用例零影响。
if [[ "${1:-}" == "pr" ]]; then
  if [[ "${2:-}" == "list" ]]; then
    if [[ -n "${STUB_GH_PRS_FILE:-}" && -f "$STUB_GH_PRS_FILE" ]]; then
      cat "$STUB_GH_PRS_FILE"
      exit 0
    fi
  elif [[ "${2:-}" == "view" ]]; then
    if [[ -n "${STUB_GH_VIEW_DIR:-}" ]]; then
      _vf="$STUB_GH_VIEW_DIR/pr-${3:-}.json"
      if [[ -f "$_vf" ]]; then
        cat "$_vf"
        exit 0
      fi
      echo "gh stub: pr view 数据文件缺失: $_vf" >&2
      exit 1
    fi
  elif [[ "${2:-}" == "create" ]]; then
    # l2_ledger.sh publish 的 PR 创建面（09-12 台账环）：默认给一个固定 URL，失败可注毒
    if [[ -n "${STUB_GH_PR_CREATE_FAIL:-}" ]]; then
      echo "gh stub: 模拟 pr create 失败" >&2
      exit 1
    fi
    printf '%s\n' "${STUB_GH_PR_CREATE_URL:-https://github.com/NousResearch/hermes-agent/pull/1}"
    exit 0
  fi
fi

# `gh api ... --jq '.[0].number'`（scan_gate --init 游标拨号）
jq_expr_file="$LOG_DIR/bodies/$NAME-$n.jq"
if [[ -f "$jq_expr_file" && "${STUB_GH_LATEST:-}" != "" ]]; then
  if grep -qF '.[0].number' "$jq_expr_file"; then
    printf '%s\n' "$STUB_GH_LATEST"
    exit 0
  fi
fi

if [[ -n "${STUB_GH_ISSUES_FILE:-}" && -f "$STUB_GH_ISSUES_FILE" ]]; then
  cat "$STUB_GH_ISSUES_FILE"
else
  printf '[]\n'
fi
exit 0
